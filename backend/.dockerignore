# Mirrors .gitignore's job, but for the build context instead of git: without
# this, `docker build` zips up node_modules (rebuilt inside the image anyway,
# so shipping the host's copy is pure waste and can smuggle in your local
# OS's native bindings) and .env (your actual secrets, baked into an image
# layer forever — `docker history` can reveal it even if a later layer
# "deletes" it).
node_modules
npm-debug.log

.env
.env.*

.git
.gitignore

# Dev-only: not imported by server.js, no reason to ship them.
test
scripts

*.md